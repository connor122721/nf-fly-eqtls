// nextflow.config for nf-fly-eqtls
// Set the parameters below to match your environment and analysis.
// Any parameter can be overridden on the command line, e.g. --expr_pcs "0,5,10" --best_k 10

params {

    // Inputs
    counts = "/project/berglandlab/connor/fly_QTLs_2026/dm3.featureCountMatrix.fixedNames"
    metadata = "/project/berglandlab/connor/fly_QTLs_2026/dm3.metadata.tsv"   // sample, cage_name, fly_number, condition
    vcf = "/project/berglandlab/connor/fly_QTLs_2026/filtered.all.vcf.gz"     // needs .tbi alongside
    gtf = "/project/berglandlab/connor/fly_QTLs_2026/dm3.ensGene.gtf"         // gene_id must match count matrix (FBgn)
    chrom_file = "/project/berglandlab/connor/fly_QTLs_2026/chromosomes"     // 2L 2R 3L 3R X, no header

    // Output
    out = "/scratch/csm6hg/fly_eqtl/output"
    prefix = "fly"

    // Expression QC / normalization
    sample_col = "sample"
    cpm_threshold = 1          // gene kept if CPM >= this ...
    count_threshold = 6        // ... and counts >= this ...
    sample_frac = 0.2          // ... in >= this fraction of samples
    min_lib_size = 0           // absolute minimum library size (0 = only MAD filter)
    lib_mad = 3                // drop samples < median - lib_mad * MAD (log10 library size, detected genes)
    pca_outlier_p = 0.05       // Bonferroni Mahalanobis p-value on expression PCs 1-5
    norm_method = "int"        // "int" (TMM logCPM + inverse normal) or "logcpm"

    // Covariate model: norm exp ~ cage_name + condition (+ genotype PCs + K expression PCs)
    covariate_formula = "~ cage_name + condition"
    factor_covariates = "cage_name,condition"
    n_geno_pcs = 0             // genotype PCs to include as covariates
    expr_pcs = "0,5,10,15,20"  // one model per K expression PCs; best K picked by eGene count
    best_k = null              // set an integer to force K for the nominal pass

    // Genotype filters
    maf = 0.05
    geno_missing = 0.5         // max per-variant missingness (plink2 --geno)
    pca_chroms = "2L,2R,3L,3R"
    pca_maf = 0.05
    pca_geno = 0.2
    n_pca = 10
    plink_chr_set = "4 no-y no-xy no-mt"  // fly: autosomes 1-4 (2L etc. as extra contigs), X, no Y/PAR/MT

    // tensorQTL
    cis_window = 100000        // +/- bp around TSS
    permutations = 10000
    seed = 42
    fdr = 0.05

    // Containers
    container_wgs = 'library://connmurr243/wgs/wgs_common:latest'                    // bcftools, plink2
    container_tensorqtl = 'library://connmurr243/wgs/topchef_tensorqtl_python.sif:latest'
    container_r = 'library://connmurr243/wgs/fly_eqtl_r.sif:latest'                  // build from definition/fly_eqtl_r.def

    // SLURM
    partition = 'standard'
    account = 'berglandlab'
}

profiles {
    slurm {
        process {
            executor = 'slurm'
            clusterOptions = "--partition=${params.partition} --account=${params.account}"
        }
    }
}

// Containers
apptainer.enabled = true
apptainer.autoMounts = true
apptainer.pullTimeout = '120m'

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'finish'
    cpus = 2
    memory = '8 GB'
    time = '4h'

    withLabel: 'small' {
        cpus = 2
        memory = '16 GB'
    }
    withLabel: 'plink' {
        cpus = 4
        memory = '16 GB'
    }
    withLabel: 'tensorqtl' {
        cpus = 8
        memory = '30 GB'
        time = '12h'
    }
}

dag {
    enabled = true
    file = 'flowchart.html'
    overwrite = true
}

report {
    enabled = true
    file = 'report.html'
    overwrite = true
}
